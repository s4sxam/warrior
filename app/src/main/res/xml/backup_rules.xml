<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 6–11 (android:fullBackupContent).

  Everything WARRIOR already backed up (habit history, profile, theme) is still backed up — there is NO
  <include> element, so the default "back up everything" behaviour is unchanged.

  The NNN challenge store holds sensitive accountability records (events, check-ins, monitoring history).
  It lives in its OWN DataStore file so it can be excluded precisely. Keep this name in sync with
  NnnDataStore.NAME ("nnn_private_v1"). DataStore writes <name>.preferences_pb via a temporary file.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/nnn_private_v1.preferences_pb" />
    <exclude domain="file" path="datastore/nnn_private_v1.preferences_pb.tmp" />
</full-backup-content>
